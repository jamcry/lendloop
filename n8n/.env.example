# Referenced by docker-compose.yml. Copy to .env and fill in.
#   cp .env.example .env

# HMAC key shared with the Convex deployment (npx convex env set LENDLOOP_SHARED_SECRET ...).
# 32+ random bytes: openssl rand -hex 32
LENDLOOP_SHARED_SECRET=

# Your Convex HTTP actions URL (note: .convex.site, not .convex.cloud).
# It is written to .env.local by `npx convex dev` as NEXT_PUBLIC_CONVEX_SITE_URL
# (it is not a deployment env var, so `npx convex env get` won't show it).
LENDLOOP_SITE_URL=

# n8n encrypts stored credentials with this. Generate once and keep it:
#   openssl rand -hex 32
# Losing it means re-entering every credential.
N8N_ENCRYPTION_KEY=
