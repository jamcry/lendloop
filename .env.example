# ---- Next.js / Clerk ----
# Clerk app: https://dashboard.clerk.com -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Where Clerk sends users after auth
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/browse
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/browse

# ---- Convex ----
# Written automatically by `npx convex dev`. Also available in the Convex dashboard.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# HTTP actions base URL (note: .convex.site, not .convex.cloud). Also written by
# `npx convex dev` to .env.local. The n8n container needs this exact value as
# LENDLOOP_SITE_URL in n8n/.env.
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Comma-separated emails that are made admin on EVERY sync (re-applied if demoted).
# Server-side only (set with `npx convex env set ADMIN_EMAILS you@example.com`).
ADMIN_EMAILS=you@example.com

# Set to "true" to allow the demo seed mutation to run against this deployment.
SEED_ENABLED=true

# ---- n8n automation (see docs/n8n-design.md) ----
# Shared secret for HMAC signing in both directions. Must match LENDLOOP_SHARED_SECRET in n8n/.env.
# NOTE: both of these are read by the CONVEX DEPLOYMENT, not by Next.js.
#   npx convex env set LENDLOOP_SHARED_SECRET "$(openssl rand -hex 32)"
#   npx convex env set N8N_WEBHOOK_URL https://<tunnel>/webhook/lendloop/request-event
# They are listed here only so the names are discoverable; editing this file does
# nothing for the running app.
LENDLOOP_SHARED_SECRET=change-me-32-bytes-minimum

# On the default anonymous LOCAL deployment, localhost is reachable and this
# works as written. On a cloud-linked deployment, Convex cannot reach local n8n:
# tunnel it (ngrok http 5678) and point this at the tunnel. Either way,
# unreachable webhooks retry and then fail visibly in the admin panel.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop/request-event
