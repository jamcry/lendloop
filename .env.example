# ---- Next.js / Clerk ----
# Clerk app: https://dashboard.clerk.com -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Where Clerk sends users after auth
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/browse
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/browse

# ---- Convex ----
# Written automatically by `npx convex dev`. Also available in the Convex dashboard.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Comma-separated emails that are promoted to the admin role on first sign-in.
# Server-side only (set with `npx convex env set ADMIN_EMAILS you@example.com`).
ADMIN_EMAILS=you@example.com

# Set to "true" to allow the demo seed mutation to run against this deployment.
SEED_ENABLED=true

# ---- n8n (not implemented yet, see docs/n8n-design.md) ----
# Shared secret for HMAC signing in both directions. Must match the n8n credential.
LENDLOOP_SHARED_SECRET=change-me-32-bytes-minimum
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop/request-event
N8N_API_KEY=
